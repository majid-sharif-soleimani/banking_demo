{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "account_opened",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Accounts opened an account; it can now receive money and serve as a loan repayment account.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "accountId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the account."
    },
    "accountNumber": {
      "type": "string",
      "description": "The 9-digit account number: 8 random digits and a Luhn check digit.",
      "pattern": "^[1-9][0-9]{8}$"
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the owning customer."
    },
    "accountType": {
      "type": "string",
      "description": "Current or Savings.",
      "pattern": "^(Current|Savings)$"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency of the account, for example SEK.",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "accountId",
    "accountNumber",
    "customerId",
    "accountType",
    "currency"
  ]
}
