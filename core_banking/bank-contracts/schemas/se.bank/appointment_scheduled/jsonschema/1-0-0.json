{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "appointment_scheduled",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "An in-person appointment was booked for an application; Lending changes its status.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "appointmentId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the appointment."
    },
    "applicationId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the application."
    },
    "employeeId": {
      "type": "string",
      "description": "Employee, for example E001.",
      "pattern": "^E[0-9]{3}$"
    },
    "startsAt": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the 60-minute slot."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "appointmentId",
    "applicationId",
    "employeeId",
    "startsAt"
  ]
}
