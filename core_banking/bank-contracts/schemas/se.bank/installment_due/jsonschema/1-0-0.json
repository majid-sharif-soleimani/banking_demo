{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "installment_due",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Lending asks Accounts to collect a due installment in full from the repayment account.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "collectionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this collection attempt; Accounts debits at most once per id."
    },
    "scheduleItemNumber": {
      "type": "integer",
      "description": "Installment number."
    },
    "accountId": {
      "type": "string",
      "format": "uuid",
      "description": "Repayment account."
    },
    "amount": {
      "type": "object",
      "description": "Full unpaid amount of the installment, penalty included.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "Due date of the installment."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "collectionId",
    "scheduleItemNumber",
    "accountId",
    "amount",
    "dueDate"
  ]
}
