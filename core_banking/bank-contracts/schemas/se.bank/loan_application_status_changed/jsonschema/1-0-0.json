{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_application_status_changed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "An application moved to another status; Customers records it in the interaction history.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "applicationId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the application."
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Applicant."
    },
    "fromStatus": {
      "type": "string",
      "description": "Previous status.",
      "pattern": "^[A-Za-z]+$"
    },
    "toStatus": {
      "type": "string",
      "description": "New status.",
      "pattern": "^[A-Za-z]+$"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why, for a rejection or cancellation; otherwise null."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "applicationId",
    "customerId",
    "fromStatus",
    "toStatus",
    "reason"
  ]
}
