{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_application_submitted",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "A customer applied for a loan; Customers records it in the interaction history.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "applicationId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the application."
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Applicant."
    },
    "productCode": {
      "type": "string",
      "description": "Loan product code, for example CAR.",
      "pattern": "^[A-Z]+$"
    },
    "requestedAmount": {
      "type": "object",
      "description": "Amount applied for.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "termMonths": {
      "type": "integer",
      "description": "Term in months."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "applicationId",
    "customerId",
    "productCode",
    "requestedAmount",
    "termMonths"
  ]
}
