{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_classification_changed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "A loan moved between Current, Overdue and Default; Customers sends a warning email.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Borrower."
    },
    "fromClassification": {
      "type": "string",
      "description": "Previous classification.",
      "pattern": "^(Current|Overdue|Default)$"
    },
    "toClassification": {
      "type": "string",
      "description": "New classification.",
      "pattern": "^(Current|Overdue|Default)$"
    },
    "daysPastDue": {
      "type": "integer",
      "description": "Days past due on the business date."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "customerId",
    "fromClassification",
    "toClassification",
    "daysPastDue"
  ]
}
