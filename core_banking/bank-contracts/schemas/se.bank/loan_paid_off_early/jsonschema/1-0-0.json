{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_paid_off_early",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "A loan was paid off early; Customers sends a confirmation email.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Borrower."
    },
    "amount": {
      "type": "object",
      "description": "Amount paid.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "waivedInterest": {
      "type": "object",
      "description": "Future interest the bank gave up.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "customerId",
    "amount",
    "waivedInterest"
  ]
}
