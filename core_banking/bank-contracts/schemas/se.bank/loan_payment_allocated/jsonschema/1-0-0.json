{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_payment_allocated",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Lending allocated a payment to a loan; Ledger posts it with this split.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "paymentId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the payment (collection or card payment)."
    },
    "source": {
      "type": "string",
      "description": "Account, Card or Payoff.",
      "pattern": "^(Account|Card|Payoff)$"
    },
    "principal": {
      "type": "object",
      "description": "Part that repaid principal.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "interest": {
      "type": "object",
      "description": "Part that paid interest.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "penalty": {
      "type": "object",
      "description": "Part that paid penalties.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "paymentId",
    "source",
    "principal",
    "interest",
    "penalty"
  ]
}
