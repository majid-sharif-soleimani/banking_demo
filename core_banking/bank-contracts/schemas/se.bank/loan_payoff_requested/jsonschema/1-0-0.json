{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "loan_payoff_requested",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "The customer asked to pay off a loan early; Accounts debits the quoted amount and answers.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "collectionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this payoff attempt."
    },
    "accountId": {
      "type": "string",
      "format": "uuid",
      "description": "Repayment account."
    },
    "amount": {
      "type": "object",
      "description": "The payoff quote for the business date.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "collectionId",
    "accountId",
    "amount"
  ]
}
