{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "money_transferred",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Money moved between two accounts in the bank, converted when their currencies differ; the ledger posts the FX entry.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "transferId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the transfer."
    },
    "fromAccountId": {
      "type": "string",
      "format": "uuid",
      "description": "Account debited."
    },
    "toAccountId": {
      "type": "string",
      "format": "uuid",
      "description": "Account credited."
    },
    "amount": {
      "type": "object",
      "description": "Amount debited, in the source account currency.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "convertedAmount": {
      "type": "object",
      "description": "Amount credited, in the target account currency; equal to Amount when the currencies are the same.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "fxRate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Units of the target currency per unit of the source currency, as a decimal string; null without conversion.",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "fxSource": {
      "type": [
        "string",
        "null"
      ],
      "description": "Where the rate came from, for example riksbank; null without conversion."
    },
    "standingOrderId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Id of the standing order that made the transfer; null for a direct transfer."
    },
    "fee": {
      "type": [
        "object",
        "null"
      ],
      "description": "Fee charged to the source account; always null in phase 1 (no fees), kept so a fee is not a breaking change.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "transferId",
    "fromAccountId",
    "toAccountId",
    "amount",
    "convertedAmount",
    "fxRate",
    "fxSource",
    "standingOrderId",
    "fee"
  ]
}
