{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "payment_collected",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Accounts debited a loan payment; Lending allocates it.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "collectionId": {
      "type": "string",
      "format": "uuid",
      "description": "The collection this answers."
    },
    "scheduleItemNumber": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Installment number; null for a payoff."
    },
    "purpose": {
      "type": "string",
      "description": "Installment or Payoff.",
      "pattern": "^(Installment|Payoff)$"
    },
    "amount": {
      "type": "object",
      "description": "Amount debited.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "collectionId",
    "scheduleItemNumber",
    "purpose",
    "amount"
  ]
}
