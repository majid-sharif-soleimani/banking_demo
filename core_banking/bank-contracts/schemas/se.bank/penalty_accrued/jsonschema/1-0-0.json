{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "penalty_accrued",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "Lending added late penalties to a loan at end of day; reporting only, no journal entry.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "loanId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the loan."
    },
    "amount": {
      "type": "object",
      "description": "Penalty added for the day.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Business date of the penalty."
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "loanId",
    "amount",
    "date"
  ]
}
