{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "self": {
    "vendor": "se.bank",
    "name": "standing_order_failed",
    "format": "jsonschema",
    "version": "1-0-0"
  },
  "description": "A standing order could not run on its date (insufficient funds); it is not retried. Customers emails the customer.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this event; the consumer inbox key."
    },
    "occurredOn": {
      "type": "string",
      "format": "date",
      "description": "Business date on which the event happened."
    },
    "performedBy": {
      "type": "string",
      "description": "Actor id that caused the event, 'system' by default.",
      "minLength": 1
    },
    "standingOrderId": {
      "type": "string",
      "format": "uuid",
      "description": "Id of the standing order."
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Owner of the source account."
    },
    "fromAccountId": {
      "type": "string",
      "format": "uuid",
      "description": "Account that should have been debited."
    },
    "amount": {
      "type": "object",
      "description": "The amount of the order, in the source account currency.",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "runDate": {
      "type": "string",
      "format": "date",
      "description": "The business date of the failed run."
    },
    "reason": {
      "type": "string",
      "description": "Why it failed, for example insufficient_funds.",
      "pattern": "^[a-z_]+$"
    }
  },
  "required": [
    "eventId",
    "occurredOn",
    "performedBy",
    "standingOrderId",
    "customerId",
    "fromAccountId",
    "amount",
    "runDate",
    "reason"
  ]
}
