<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared bank packages from ../.local-feed; exact versions (implementation-decisions, "Package versions"). -->
    <PackageVersion Include="Bank.Contracts" Version="0.6.1" />
    <PackageVersion Include="Bank.Common" Version="0.6.1" />
    <PackageVersion Include="Bank.Toolkit.Data" Version="0.6.1" />
    <PackageVersion Include="Bank.Messaging" Version="0.6.1" />
    <PackageVersion Include="Bank.Messaging.Kafka" Version="0.6.1" />
    <PackageVersion Include="Bank.ServiceDefaults" Version="0.1.0" />
    <PackageVersion Include="Bank.Testing" Version="0.6.1" />
    <!-- Service -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.2" />
    <!-- Tests and design time -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.16.0" />
  </ItemGroup>
</Project>
