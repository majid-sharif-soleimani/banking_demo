{
  // Column names of the CSV export (Import:Columns:<file>:<field> = "column in the file"). The defaults are the field names;
  // check them against the real databasesample.com export before the first real run (stage 7 plan).
  "Import": {
    "AmountFactor": 10.0,
    "Customers": 100,
    "Seed": 20260101,
    "Data": "data/raw",
    "Report": "data/import-report.md",
    "Columns": {
      "customers": { "id": "id", "first_name": "first_name", "last_name": "last_name", "date_of_birth": "date_of_birth", "email": "email", "phone": "phone", "address": "address" },
      "accounts": { "id": "id", "customer_id": "customer_id", "type": "type" },
      "transactions": { "id": "id", "account_id": "account_id", "date": "date", "kind": "kind", "amount": "amount", "target_account_id": "target_account_id" },
      "loans": { "id": "id", "customer_id": "customer_id", "account_id": "account_id", "type": "type", "amount": "amount", "term_months": "term_months", "start_date": "start_date" },
      "loan_payments": { "id": "id", "loan_id": "loan_id", "date": "date", "amount": "amount", "late": "late" },
      "standing_orders": { "id": "id", "account_id": "account_id", "target_account_id": "target_account_id", "amount": "amount", "frequency": "frequency", "start_date": "start_date", "end_date": "end_date" }
    }
  }
}
