<Project Sdk="Aspire.AppHost.Sdk/13.6.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Only an id: the secret parameter values live in the user profile, never in the repo. -->
    <UserSecretsId>bef4f1b4-4d03-40a9-9659-24479c525efe</UserSecretsId>
    <!-- We run with dotnet run, not the Aspire CLI: the SDK takes the orchestrator and dashboard from NuGet instead. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The services, in the stages that create them; each reference generates a Projects.<Name> type. -->
    <ProjectReference Include="..\..\..\bank-operations\src\Bank.Operations.Api\Bank.Operations.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-customers\src\Bank.Customers.Api\Bank.Customers.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-accounts\src\Bank.Accounts.Api\Bank.Accounts.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-lending\src\Bank.Lending.Api\Bank.Lending.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-cards\src\Bank.Cards.Api\Bank.Cards.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-ledger\src\Bank.Ledger.Api\Bank.Ledger.Api.csproj" />
    <ProjectReference Include="..\..\..\bank-gateway\src\Bank.Gateway\Bank.Gateway.csproj" />
  </ItemGroup>
</Project>
